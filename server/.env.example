# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=orbit_app
DB_PASSWORD=change_me
DB_NAME=orbit_planner

# --- Auth ---
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# This is a long-lived safety backstop for the session cookie, NOT the idle timeout below.
# The real 20-minute inactivity check happens server-side against last_activity_at in MySQL.
JWT_EXPIRES_IN=7d

# The actual idle/session timeout, in minutes — enforced on every request via the database,
# so it works correctly even if the browser is closed and reopened later.
SESSION_IDLE_MINUTES=20

# Lockout policy
MAX_LOGIN_ATTEMPTS=3

# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
